{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/interview_record.schema.json",
  "title": "InterviewRecord",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "interview_id", "participant_id", "language", "stage", "questions", "prior_exposure", "consent", "created_at"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "interview_id": {"type": "string", "minLength": 1},
    "participant_id": {"type": "string", "minLength": 1},
    "language": {"type": "string", "minLength": 2},
    "stage": {"enum": ["free_recall", "neutral_clarification", "cued_recall", "review", "other"]},
    "questions": {"type": "array", "items": {"$ref": "#/$defs/question"}},
    "prior_exposure": {"type": "object", "additionalProperties": false, "required": ["exposed", "details"], "properties": {"exposed": {"type": "boolean"}, "details": {"type": "string"}}},
    "consent": {"type": "object", "additionalProperties": false, "required": ["status", "scope"], "properties": {"status": {"enum": ["obtained", "not_obtained", "withdrawn", "unknown"]}, "scope": {"type": "string"}}},
    "created_at": {"type": "string", "format": "date-time"},
    "ended_at": {"type": ["string", "null"], "format": "date-time"}
  },
  "$defs": {
    "question": {
      "type": "object", "additionalProperties": false,
      "required": ["question_id", "question_type", "question_text", "answer_text", "source_type", "timestamp"],
      "properties": {"question_id": {"type": "string"}, "question_type": {"enum": ["open", "neutral_clarification", "cued", "closed", "other"]}, "question_text": {"type": "string"}, "answer_text": {"type": "string"}, "source_type": {"enum": ["user_free_recall", "user_cued_recall", "user_response_to_neutral_clarification", "unknown"]}, "timestamp": {"type": "string", "format": "date-time"}, "evidence_id": {"type": ["string", "null"]}}
    }
  }
}
